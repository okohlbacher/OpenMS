+    std::string readIndexedFragment(std::ifstream& stream, std::streampos start, std::streampos end, const std::string& filename)
+    {
+      std::string text;
+      if (start < 0 || end < start)
+      {
+        throw Exception::ParseError(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION, filename, "Invalid indexed XML fragment bounds");
+      }
+      const std::streamoff length = end - start;
+      if (length > std::numeric_limits<std::streamsize>::max() ||
+          static_cast<std::uintmax_t>(length) > text.max_size())
+      {
+        throw Exception::ParseError(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION, filename, "Invalid indexed XML fragment bounds");
+      }
+      // Read into the final string, avoiding a second spectrum-sized allocation
+      // and copy on every random read (particularly costly for IM spectra).
+      text.resize(static_cast<Size>(length));
+      stream.clear();
+      stream.seekg(start, std::ios::beg);
+      if (!stream) { throw Exception::ParseError(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION, filename, "Cannot seek to indexed XML fragment"); }
+      stream.read(text.data(), static_cast<std::streamsize>(length));
+      if (!stream || stream.gcount() != length)
+      {
+        throw Exception::ParseError(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION, filename, "Truncated indexed XML fragment");
+      }
+      return text;
+    }
+  }
